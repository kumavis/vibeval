#!/usr/bin/env node
// Fake `codex` CLI for tests: speaks just enough of the `exec --json` event
// stream. Echoes the received prompt and whether the invocation was a
// resume, so tests can assert thread continuity and transcript replay.
// Exits without a message when the prompt is exactly "DIE", simulating a
// failed turn.
import { readFileSync } from 'node:fs';
if (process.argv.includes('--version')) { process.stdout.write('fixture-cli 1\n'); process.exit(0); }
function submissionReply(prompt) {
  if (process.env.VIBEVAL_FIXTURE_SUBMISSION === 'text') return JSON.stringify({ action: 'submit', content: '  |\n__|__\n\\___/' });
  return JSON.stringify(prompt.includes('Begin your work.') ? { action: 'write_file', path: 'index.html', content: '<html><body>fixture page</body></html>' } : { action: 'submit' });
}

const args = process.argv.slice(2);
const resumed = args[1] === 'resume' ? args[2] : null;
// Echo the sandbox knobs the provider set, so tests can assert them.
const webSearch = args.includes('tools.web_search=true');
// The developer_instructions override, so tests can assert what the player
// was actually told about its tools.
const instructions =
  args.find((a) => a.startsWith('developer_instructions=')) ?? '';
const prompt = readFileSync(0, 'utf8');

const emit = (event) => process.stdout.write(JSON.stringify(event) + '\n');

emit({ type: 'thread.started', thread_id: resumed ?? 'thread-1' });
emit({ type: 'turn.started' });
if (prompt === 'HANG') { setInterval(() => {}, 1000); await new Promise(() => {}); }
if (prompt === 'DIE') {
  emit({ type: 'turn.failed', error: { message: 'simulated failure' } });
  process.exit(1);
}
emit({
  type: 'item.completed',
  item: { id: 'r0', type: 'reasoning', text: 'ignored' },
});
emit({
  type: 'item.completed',
  item: {
    id: 'item_0',
    type: 'agent_message',
    text: prompt === 'SCHEMA' ? JSON.stringify({schema: args.includes('--output-schema') ? JSON.parse(readFileSync(args[args.indexOf('--output-schema')+1], 'utf8')) : null, resumed}) : process.env.VIBEVAL_FIXTURE_SUBMISSION ? submissionReply(prompt) : prompt === 'GENERATE_TEST_PAGE' ? (instructions.includes('# Response Format:') ? 'Unexpected command protocol' : '<html><body>Test page</body></html>') : `command_format:${instructions.includes('# Response Format:')}\nthread:${resumed ?? 'new'}\nweb_search:${webSearch}\ntold_about_search:${instructions.includes('You have web search available')}\nreceived:${prompt.split('\n')[0]}\nCOMMAND: LOOK`,
  },
});
emit({
  type: 'turn.completed',
  usage: {
    input_tokens: 100,
    output_tokens: 10,
    cached_input_tokens: 50,
    cache_write_input_tokens: 5,
    reasoning_output_tokens: 4,
  },
});
