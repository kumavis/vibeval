#!/usr/bin/env node
// Fake `claude` CLI for tests: speaks just enough of the stream-json
// protocol. Each result echoes this process's pid and the received text so
// tests can assert process reuse and transcript replay. Exits silently
// (no result) when the text is exactly "DIE" to simulate a crash.
import { createInterface } from 'node:readline';
if (process.argv.includes('--version')) { process.stdout.write('fixture-cli 1\n'); process.exit(0); }
function submissionReply(prompt) {
  if (process.env.VIBEVAL_FIXTURE_SUBMISSION === 'text') return JSON.stringify({ action: 'submit', content: '  |\n__|__\n\\___/' });
  return JSON.stringify(prompt.includes('Begin your work.') ? { action: 'write_file', path: 'index.html', content: '<html><body>fixture page</body></html>' } : { action: 'submit' });
}

const rl = createInterface({ input: process.stdin });
const args = process.argv.slice(2);
const instructions = args[args.indexOf('--system-prompt') + 1] || '';
const commandFormat = instructions.includes('# Response Format:');
// Like the real CLI, cost and api time are cumulative within one process.
let turns = 0;
rl.on('line', (line) => {
  const { message } = JSON.parse(line);
  const text = message.content.map((block) => block.text).join('');
  if (text === 'DIE') {
    process.exit(0);
  }
  process.stdout.write(JSON.stringify({
    type: 'result',
    subtype: 'success',
    is_error: false,
    total_cost_usd: 0.01 * (turns += 1),
    duration_api_ms: 5 * turns,
    usage: { input_tokens: 100, output_tokens: 10, cache_read_input_tokens: 50, cache_creation_input_tokens: 5 },
    result: process.env.VIBEVAL_FIXTURE_SUBMISSION ? submissionReply(text) : text === 'GENERATE_TEST_PAGE' ? (commandFormat ? 'Unexpected command protocol' : '<html><body>Test page</body></html>') : `command_format:${commandFormat}\npid:${process.pid}\nreceived:${text.split('\n')[0]}\nCOMMAND: LOOK`,
  }) + '\n');
});
