  "description": "An LLM plays Zork I through an OpenAI-compatible API and a z-machine WebAssembly interpreter",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
