# Pick a backend explicitly, or leave unset to auto-detect from which API key
# is present (OPENAI_API_KEY, then ANTHROPIC_API_KEY).
# LLM_PROVIDER="openai"   # "openai" | "anthropic" | "claude-cli" | "codex-cli" | "opencode-cli"

## OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: point at any OpenAI-compatible server, e.g. LM Studio or Ollama.
# OPENAI_BASE_URL="http://127.0.0.1:1234/v1/"
# Optional: model to use (default: gpt-5-mini).
# OPENAI_MODEL="gpt-5-mini"

## Anthropic API
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: model to use (default: claude-opus-5).
# ANTHROPIC_MODEL="claude-opus-5"
# Optional: reasoning effort per turn (default: low).
# ANTHROPIC_EFFORT="low"       # "low" | "medium" | "high" | "xhigh" | "max"

## Claude Code CLI (headless) — uses the CLI's own login, no key needed here.
# LLM_PROVIDER="claude-cli"
# Optional: model override passed to `claude --model`.
# Use a versioned ID for reproducible runs; moving aliases such as "opus"
# can resolve to a different model later.
# CLAUDE_CLI_MODEL="claude-opus-5"

## Codex CLI (headless) — uses the CLI's own ChatGPT login, no key needed
## here. Install with `brew install codex` and `codex login` first.
# LLM_PROVIDER="codex-cli"
# Optional: model override passed to `codex --model`.
# CODEX_CLI_MODEL="gpt-5.6-sol"
# Optional: reasoning effort per turn (default: the model's own default,
# which differs between models — pin it to compare them fairly).
# CODEX_CLI_EFFORT="medium"   # "low" | "medium" | "high" | "xhigh" | "max"

## OpenCode CLI (headless) — uses whichever providers the CLI is already
## logged in to, no key needed here. Install with `brew install opencode`
## and `opencode auth login` first.
# LLM_PROVIDER="opencode-cli"
# Model in the CLI's provider/model form (`opencode models` lists them).
# OPENCODE_CLI_MODEL="anthropic/claude-sonnet-4-5"
# Optional: model variant / reasoning effort passed to `opencode run --variant`.
# OPENCODE_CLI_EFFORT="high"   # model-specific, e.g. "minimal" | "high" | "max"
